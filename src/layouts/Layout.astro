---
import '../styles/global.css';
import { url } from '../lib/paper';
interface Props { title?: string }
const { title = 'Sharks n Fish' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content="Our home game's leaderboard. r u a poker shark or fish?" />
  <!-- keeps friends' names and faces out of search results -->
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400;600&family=Special+Elite&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- halftone dot patterns used by the drawn stickers and stand-in portraits -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <pattern id="htLight" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" fill="#dcd8d0" /><circle cx="2" cy="2" r=".75" fill="#4a4a4a" /></pattern>
      <pattern id="htMid" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" fill="#9c988f" /><circle cx="2" cy="2" r="1.2" fill="#2c2c2c" /></pattern>
      <pattern id="htDark" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" fill="#3d3c39" /><circle cx="2" cy="2" r="1.5" fill="#0f0f0f" /></pattern>
      <pattern id="htSea" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" fill="#5d7f8a" /><circle cx="2" cy="2" r="1.25" fill="#16323d" /></pattern>
      <pattern id="htOver" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><circle cx="2" cy="2" r="1" fill="rgba(0,0,0,.28)" /></pattern>
    </defs>
  </svg>
  <slot />
</body>
</html>
