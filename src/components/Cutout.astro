---
// A player's face as a magazine cutout. Uses their photo from photos/ if there is one,
// otherwise a drawn stand-in so new players still look right.
import type { Player } from '../lib/data';
import { hash, url } from '../lib/paper';

interface Props { player: Player; class?: string; eager?: boolean }
const { player, class: cls = '', eager = false } = Astro.props;
const hair = hash(player.id) % 4;
const src = player.photo ? url(player.photo) : '';
---
{player.photo ? (
  <span class={`cut photo ${cls}`} style={`--src:url('${src}')`}>
    <img src={src} alt={player.name} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </span>
) : (
  <span class={`cut ${cls}`}>
    <svg viewBox="0 -4 120 154" role="img" aria-label={player.name}>
      {hair === 2 && <path d="M31 62 C26 28 94 28 89 62 L96 120 L24 120 Z" fill="url(#htDark)" />}
      <path d="M6 150 C8 116 30 102 60 102 C90 102 112 116 114 150 Z" fill="url(#htDark)" />
      <path d="M46 103 L60 125 L74 103 Z" fill="url(#htLight)" />
      <rect x="51" y="84" width="18" height="22" fill="url(#htMid)" />
      <ellipse cx="35.5" cy="66" rx="4.5" ry="7" fill="url(#htMid)" />
      <ellipse cx="84.5" cy="66" rx="4.5" ry="7" fill="url(#htMid)" />
      <ellipse cx="60" cy="64" rx="25" ry="29" fill="url(#htLight)" />
      {hair === 0 && <path d="M33 53 C31 24 89 22 88 48 C94 50 101 53 103 57 C88 58 48 56 33 55 Z" fill="url(#htDark)" />}
      {hair === 1 && <path d="M35 60 C30 27 90 25 86 60 C82 46 72 41 60 41 C48 41 40 48 35 60 Z" fill="url(#htDark)" />}
      {hair === 2 && <path d="M35 62 C32 30 88 30 86 62 C80 46 68 40 54 45 C46 48 39 54 35 62 Z" fill="url(#htDark)" />}
      {hair === 3 && <>
        <circle cx="60" cy="17" r="7" fill="url(#htMid)" />
        <path d="M34 47 C33 19 87 19 86 47 Z" fill="url(#htMid)" />
        <rect x="31" y="42" width="58" height="11" rx="4" fill="url(#htDark)" />
      </>}
      <path d="M45 57.5 L54 56.5 M66 56.5 L75 57.5" stroke="#111" stroke-width="2.3" stroke-linecap="round" />
      <circle cx="50" cy="63.5" r="2.6" fill="#111" />
      <circle cx="70" cy="63.5" r="2.6" fill="#111" />
      <path d="M60 65 L57 73 L62 73" stroke="#333" stroke-width="1.6" fill="none" stroke-linecap="round" />
      <path d="M51 81 Q60 86 69 81" stroke="#222" stroke-width="2.1" fill="none" stroke-linecap="round" />
    </svg>
  </span>
)}
